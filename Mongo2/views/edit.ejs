<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Chat</title>
</head>
<body>
    <h3>Edit Chat: <%= chat._id %></h3>
    <p>This chat is sent from <i><b><%= chat.from %></b></i> to <i><b><%= chat.to %></b></i></p>
    <form action="/chats/<%= chat._id %>?_method=PUT" method="POST">
        <textarea name="msg">Write edited message</textarea><br>
        <button>Submit</button>
    </form>
</body>
</html>