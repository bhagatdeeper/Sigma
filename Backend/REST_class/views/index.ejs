<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Opera</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>
    <h1>Opera Posts</h1>
    <% for(post of posts) {%>
        <div class="post">
            <h3 class="user">@<%= post.username %></h3>
            <h4 class="cont"><%= post.content %></h4>
        </div>
    <% } %>

    <a href="/posts/new">Create new post</a>
</body>
</html>